# ==========================================
# MBlog 部署环境变量模板
# 复制此文件为 .env 并修改配置
# Usage: docker compose up -d
# ==========================================

# ===== 数据库配置（PostgreSQL） =====
# 使用内置 PostgreSQL 时只需设置密码
# 使用外部数据库时还需设置 DB_HOST/DB_PORT/DB_NAME/DB_USER

# PostgreSQL 密码（内置和外部数据库都需要）
DB_PASSWORD=mblog_pass

# 以下为外部数据库连接信息（docker-compose.external-db.yml 需要）
# 使用默认 docker-compose.yml（内置 PG）时无需设置
# DB_HOST=192.168.1.100
# DB_PORT=5432
# DB_NAME=mblog
# DB_USER=mblog_user

# ===== JWT 认证配置 =====
# 用于生成和验证用户登录令牌
# 重要：生产环境请使用随机长字符串（至少 32 个字符）
# 此变量通过 docker-compose 映射为 Jwt__Key，覆盖 appsettings.json 中的默认值
JWT_KEY=your-super-secret-key-change-this-in-production!!

# JWT 签发者与受众（可保持默认）
# JWT_ISSUER=mblog-api
# JWT_AUDIENCE=mblog-client

# ===== 站点配置 =====
# 站点访问 URL（最终用户通过浏览器访问的地址）
# 用于前台页面链接生成和 SEO canonical URL
SITE_URL=http://localhost

# 站点名称（显示在页面标题、导航栏等位置）
SITE_NAME=个人博客

# API 后端地址（前端和管理端通过此地址调用 API）
# 生产环境推荐使用 Nginx 反向代理路径，如 https://your-domain.com/api
# 注意：构建时会编译到前端静态文件中，修改后需要重新构建
API_BASE_URL=http://localhost:5000/api

# Next.js 服务端渲染时直连后端的内部地址
# 在 Docker Compose 中默认为 http://api:5000/api（后端服务名 api，端口 5000）
# 非 Docker 环境与 API_BASE_URL 保持一致即可
INTERNAL_API_BASE_URL=http://api:5000/api

# ===== 前台缓存失效（与 frontend 的 REVALIDATE_SECRET 保持一致） =====
# 后端在文章/分类/标签/项目变更后会调用此地址通知 Next.js 失效缓存
# Docker 内部网络使用 frontend:3000；非 Docker 部署改成 http://localhost:3000/api/revalidate
FRONTEND_REVALIDATE_URL=http://frontend:3000/api/revalidate
# 双方约定密钥（至少 32 位随机字符串），生产环境务必修改
FRONTEND_REVALIDATE_SECRET=dev-frontend-revalidate-secret-change-me
