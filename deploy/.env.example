# ==========================================
# MBlog 部署环境变量模板
# 复制此文件为 .env 并修改配置
# ==========================================

# 数据库密码（PostgreSQL）
DB_PASSWORD=mblog_pass

# JWT 签名密钥（至少 32 个字符）
JWT_KEY=your-super-secret-key-change-this-in-production!!

# 站点 URL（Nginx 代理地址）
SITE_URL=http://localhost

# 站点名称
SITE_NAME=个人博客

# API 地址（对前端和管理端暴露的 URL）*
# * 在 Docker 中构建时会被 inlined 到前端静态文件中
# * 注意：生产环境应使用实际域名，如 https://blog.example.com/api
# * 如果通过 Nginx 代理（推荐），通常为 http://localhost/api 或 /api
API_BASE_URL=http://localhost:5000/api