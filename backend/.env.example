# 数据库连接
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=mblog;Username=mblog_user;Password=mblog_pass

# JWT 配置
Jwt__Key=your-super-secret-key-at-least-32-characters-long
Jwt__Issuer=mblog-api
Jwt__Audience=mblog-client
Jwt__AccessTokenExpirationMinutes=120
Jwt__RefreshTokenExpirationDays=7

# 文件存储
Storage__RootPath=./uploads

# CORS 允许来源（前台 + 后台）
Cors__AllowedOrigins=http://localhost:3000,http://localhost:5173

# 管理员默认账号（首次初始化用）
Admin__Username=admin
Admin__Password=admin123
Admin__Email=admin@example.com