{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=192.168.200.23;Port=5440;Database=m-blog;Username=m-blog;Password=123456"
    //"DefaultConnection": "Host=192.168.200.23;Port=5433;Database=mblog;Username=mblog_user;Password=mblog_pass"
  },
  "Jwt": {
    "Key": "your-super-secret-key-at-least-32-characters-long",
    "Issuer": "mblog-api",
    "Audience": "mblog-client",
    "AccessTokenExpirationMinutes": 120,
    "RefreshTokenExpirationDays": 7
  },
  "Storage": {
    "RootPath": "./uploads"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000", "http://localhost:5173"]
  },
  "Frontend": {
    "RevalidateUrl": "http://localhost:3000/api/revalidate",
    "RevalidateSecret": "dev-frontend-revalidate-secret-change-me"
  }
}