# 后端 API 地址
NEXT_PUBLIC_API_BASE_URL=http://localhost:5092/api

# 站点 URL（用于 SEO）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 站点名称
NEXT_PUBLIC_SITE_NAME=个人博客

# 与后端 appsettings.json 的 Frontend:RevalidateSecret 保持一致
# 用于后端在文章变更后调用 /api/revalidate 时的鉴权
REVALIDATE_SECRET=dev-frontend-revalidate-secret-change-me