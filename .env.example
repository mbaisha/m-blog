# ==========================================
# MBlog 部署环境变量模板
# 复制此文件为 .env 并修改配置
# Usage: docker compose up -d
# ==========================================
#
# 本文件中的变量是**生产环境运行时**配置来源，优先级：
#   1. docker-compose.yml 中 environment/env_file（即本文件）
#   2. .env 文件（被 env_file 自动加载）
#   3. .env.example 中的默认值
#
# 这些变量在容器启动时注入到进程，**不会**影响构建产物。
# 构建产物对环境无任何依赖，可以部署到任何环境（修改本文件后无需重新构建）。

# ===== 数据库配置（PostgreSQL） =====
# 使用内置 PostgreSQL 时只需设置密码
# 使用外部数据库时还需设置 DB_HOST/DB_PORT/DB_NAME/DB_USER

# PostgreSQL 密码（内置和外部数据库都需要）
DB_PASSWORD=mblog_pass

# 以下为外部数据库连接信息（docker-compose.external-db.yml 需要）
# 使用默认 docker-compose.yml（内置 PG）时无需设置
# DB_HOST=192.168.1.100
# DB_PORT=5432
# DB_NAME=mblog
# DB_USER=mblog_user

# ===== JWT 认证配置 =====
# 用于生成和验证用户登录令牌
# 重要：生产环境请使用随机长字符串（至少 32 个字符）
# 此变量通过 docker-compose 映射为 Jwt__Key，覆盖 appsettings.json 中的默认值
JWT_KEY=your-super-secret-key-change-this-in-production!!

# JWT 签发者与受众（可保持默认）
# JWT_ISSUER=mblog-api
# JWT_AUDIENCE=mblog-client

# ===== 站点配置 =====
# 站点访问 URL（最终用户通过浏览器访问的地址）
# 用于前台页面链接生成和 SEO canonical URL
# 例：https://blog.example.com  或  http://192.168.1.10:8996
SITE_URL=http://localhost

# 站点名称（显示在页面标题、导航栏等位置）
SITE_NAME=个人博客

# 浏览器端访问后端 API 的地址
# 容器内通过 Nginx 反代：推荐 /api（走 80 端口 nginx）
# 独立部署前端直连：可填 http://your-host:5000/api
# 注意：前端构建不依赖此值，修改本文件后无需重新构建前端
API_BASE_URL=/api

# Next.js 服务端渲染时直连后端的内部地址
# Docker 网络中默认为 http://api:5000/api（后端服务名 api，端口 5000）
# 非 Docker 环境与 API_BASE_URL 保持一致即可
INTERNAL_API_BASE_URL=http://api:5000/api
